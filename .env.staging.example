# Staging stack env file (tracks the `development` branch). Copy to a path OUTSIDE
# the git checkout on the server (e.g. /opt/auctionhub/env/.env.staging) — see the
# comment at the top of .env.prod.example for why.

STACK_SUFFIX=_Staging

# Bind address for postgres/redis/minio/backend/bidding-engine/recommendation-engine's
# published ports — set to this stack's Tailscale IP, never 0.0.0.0.
DOCKER_BIND_ADDR=REPLACE_WITH_TAILSCALE_IP

# Host ports — must not overlap with .env.prod.example's ports
NGINX_PORT=8081
BACKEND_PORT=18100
BIDDING_PORT=18101
RECS_PORT=18102
POSTGRES_PORT=15532
REDIS_PORT=16479
MINIO_PORT=19100

# PostgreSQL
POSTGRES_DB=FYP_AuctionPlatform_PostgreSQL_DB
POSTGRES_USER=AuctionPlatform_Developer
POSTGRES_PASSWORD=change_me_staging_postgres_password

# Redis
REDIS_PASSWORD=change_me_staging_redis_password

# MinIO / S3
MINIO_ROOT_USER=MinIO_AuctionPlatform_Developer
MINIO_ROOT_PASSWORD=change_me_staging_minio_password
S3_ACCESS_KEY=MinIO_AuctionPlatform_Developer
S3_SECRET_KEY=change_me_staging_minio_password
S3_BUCKET_ASSETS=auction-assets
S3_BUCKET_AVATARS=auction-avatars
# Browser-facing, so it must include this stack's NGINX_PORT.
S3_PUBLIC_URL=http://REPLACE_WITH_TAILSCALE_IP:8081/auction-assets

# App Settings
APP_ENV=staging
JWT_SECRET=change_me_staging_jwt_secret
INTERNAL_API_KEY=change_me_staging_internal_api_key
PROJECT_NAME="AuctionHub - API Gateway (Staging)"
API_VERSION="v1.0.0"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALLOWED_ORIGINS=http://REPLACE_WITH_TAILSCALE_IP:8081
