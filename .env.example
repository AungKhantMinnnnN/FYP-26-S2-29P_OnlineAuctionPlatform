# PostgreSQL
POSTGRES_DB=FYP_AuctionPlatform_PostgreSQL_DB
POSTGRES_USER=AuctionPlatform_Developer
POSTGRES_PASSWORD=your_postgres_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# MinIO / S3
MINIO_ROOT_USER=MinIO_AuctionPlatform_Developer
MINIO_ROOT_PASSWORD=your_minio_password_here

# Host bind address for docker-compose's published ports (postgres/redis/minio/backend/
# bidding-engine/recommendation-engine). Defaults to loopback-only. On the shared VM this
# MUST be set to the Tailscale IP (not 0.0.0.0) so these stay unreachable from the open
# internet — see docker-compose.yml. Only nginx (the app's front door) is meant to be
# reachable beyond the Tailscale network.
DOCKER_BIND_ADDR=127.0.0.1

# App Connection URLs — used by FastAPI running locally and by dockerised services
# When running locally against the shared VM, replace "localhost" with the VM's Tailscale IP.
# Or copy .env.teammate → .env.local for a pre-filled remote template.
DATABASE_URL=postgresql+asyncpg://AuctionPlatform_Developer:your_postgres_password_here@localhost:5432/FYP_AuctionPlatform_PostgreSQL_DB
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0

# Recommendation engine caching — set to false to always compute from DB
RECS_CACHE_ENABLED=true
RECS_LISTINGS_CACHE_TTL=300        # 5 min  — active listings snapshot
RECS_INTERACTIONS_CACHE_TTL=300    # 5 min  — unified interaction signals
RECS_ANONYMOUS_CACHE_TTL=300       # 5 min  — pre-scored anonymous result
RECS_USER_SIGNALS_CACHE_TTL=86400  # 24 h   — per-user brands + price profile

# S3 / MinIO Buckets
# S3_ENDPOINT is for the backend container to reach MinIO directly (docker-compose overrides this to http://minio:9000).
# Only used as-is when running the backend outside Docker against a docker-compose'd MinIO.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=MinIO_AuctionPlatform_Developer
S3_SECRET_KEY=your_minio_password_here
S3_BUCKET_ASSETS=auction-assets
S3_BUCKET_AVATARS=auction-avatars
# Public, browser-facing URL for listing images, proxied through nginx since MinIO has no published port.
# Set this to http://<your-server-domain-or-ip>/auction-assets when deploying.
S3_PUBLIC_URL=http://localhost/auction-assets

# App Settings
APP_ENV=development
JWT_SECRET=your_jwt_secret_key_here
# Shared secret the bidding-engine sends on internal-notification calls to the backend.
# Optional -- leave blank to keep today's behaviour; set the SAME value in both services
# to require it. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Rate limiting (per-IP sliding window). Override in .env.local for tighter production
# defaults or looser dev values that don't break the QA suite.
# Set RATE_LIMIT_ENABLED=false to disable all rate limiting (e.g. during
# integration/QA testing).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER=300
RATE_LIMIT_LOGIN=300
RATE_LIMIT_PASSWORD_RESET=10
RATE_LIMIT_EMAIL_VERIFICATION=10
RATE_LIMIT_CREATE_LISTING=10
RATE_LIMIT_CREATE_DISPUTE=5
RATE_LIMIT_CREATE_FEEDBACK=20
PROJECT_NAME="Online Auction Platform - API Gateway"
API_VERSION="v1.0.0"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
LOG_DIR=logs/backend_logs
BIDDING_SERVICE_URL=http://bidding-engine:8001
RECOMMENDATION_SERVICE_URL=http://recommendation-engine:8002
# BACKEND_URL is for bidding-engine/recommendation-engine to call back to the core API.
# docker-compose overrides this to http://backend:8000; only used as-is outside Docker.
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000/v1.0.0
VITE_RECS_URL=http://localhost:8002/v1.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
